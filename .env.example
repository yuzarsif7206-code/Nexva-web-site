# --- Site ---
# Vercel'deki adresiniz (alan adı bağlanınca onunla değiştirin). Sonda / olmasın.
NEXT_PUBLIC_SITE_URL=https://nexva-dijital.vercel.app
# Alan adı bağlanana kadar false kalır (site arama motorlarına kapalı).
NEXT_PUBLIC_ALLOW_INDEXING=false
# Yalnızca tasarım incelemesi için. Üretimde false.
NEXT_PUBLIC_USE_PLACEHOLDER_WORKS=false

# --- E-posta bildirimi (ZORUNLU: form talepleri bu yolla gelir) ---
GMAIL_USER=nexvadigital@gmail.com
# Google Hesabı > Güvenlik > 2 Adımlı Doğrulama açık > Uygulama şifreleri (16 hane)
GMAIL_APP_PASSWORD=
LEAD_TO_EMAIL=nexvadigital@gmail.com

# --- Kayıt veritabanı (önerilir, isteğe bağlı) ---
# Boş bırakılırsa talepler yalnızca e-postayla gelir; kayıt ve otomatik yeniden deneme çalışmaz.
SUPABASE_URL=
# Yalnızca sunucuda. Asla NEXT_PUBLIC_ yapmayın, kimseyle paylaşmayın.
SUPABASE_SERVICE_ROLE_KEY=

# --- Güvenlik ---
# Rastgele uzun metinler (ör. https://generate-secret.vercel.app/32)
IP_HASH_SALT=
CRON_SECRET=
